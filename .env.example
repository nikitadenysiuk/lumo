# Скопируй этот файл в .env и заполни своими ключами.
# .env уже в .gitignore — не коммить реальные ключи в git.

# https://supabase.com -> Project Settings -> API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Ключ Gemini в приложении БОЛЬШЕ НЕ НУЖЕН — он живёт в Supabase Edge Function
# (supabase/functions/gemini). Задаётся секретом:
#   supabase secrets set GEMINI_API_KEY=<ключ>
# Ключ бесплатного тарифа: https://aistudio.google.com/apikey
